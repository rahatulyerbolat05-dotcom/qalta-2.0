rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can only read/write their own document, and only
    // with the shape this app actually writes. Ownership alone isn't enough:
    // without the shape/size checks, an authenticated client could still
    // write an arbitrarily large or malformed blob to their own doc, which
    // costs them storage/quota and could crash the app on next read.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
             'ops', 'debts', 'closed', 'eCats', 'iCats',
             'hex', 'skin', 'set', 'lang', 'light',
             'catColors', 'catSizes', 'lastSync'
           ])
        && request.resource.data.ops is list
        && request.resource.data.ops.size() < 5000
        && request.resource.data.debts is list
        && request.resource.data.debts.size() < 1000
        && request.resource.size() < 1 * 1024 * 1024; // 1 MiB document cap
    }
  }
}
